# Lisa Telefon-KI — lokale Dev-Umgebung (nie committen als .env)
PORT=8095
DEFAULT_TENANT=meddent
DEV_PHONE=01776004600
WRITE_LIVE=1

# Qwen 3.6 auf pickadoc1 (vLLM, Tailscale). KEIN Ollama.
LLM_BASE=http://100.77.30.98:8000/v1
LLM_MODEL=qwen3.6:35b-a3b
LLM_API_KEY=local

# Stimme vorerst ElevenLabs (spaeter eigenes TTS, gleiche Schnittstelle).
# Im Container MUSS der Key hier stehen — das Nachschauen in fremden .env
# (F:\MAS-2, F:\Clara-Voice) gibt es nur auf dem Windows-Dev-Rechner.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=1iF3vHdwHKuVKSPDK23Z
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Lokales TTS auf der 5090 (tts_serve/, Chatterbox 8210 / CosyVoice 8211).
# GESETZT = es spricht NUR der lokale Container, OHNE ElevenLabs-Rueckfall
# (Chef 27.08.2026: Fehler sollen in der Testphase hoerbar sein).
# Leer = ElevenLabs wie bisher.
#   vom Dev-Rechner:    TTS_BASE=http://192.168.0.246:8210
#   im App-Container:   TTS_BASE=http://host.docker.internal:8210
TTS_BASE=

# Lokales STT auf der 5090 (stt_serve/, deutscher Conformer, Port 8212).
# GESETZT = JEDE Transkription geht an den Container, OHNE ElevenLabs-
# Rueckfall (Chef 28.08.2026: "es geht nichts mehr zu elevenlabs").
# Leer = ElevenLabs Scribe wie bisher.
#   vom Dev-Rechner:    STT_BASE=http://192.168.0.246:8212
#   im App-Container:   STT_BASE=http://host.docker.internal:8212
STT_BASE=

# Whisper-GPU-STT auf dem Dev-Rechner (W-STT-WHISPER 30.08.2026): GESETZT =
# Transkription laeuft ZUERST ueber den Whisper-Stream-Container (pickadoc-stt,
# large-v3, WebSocket) — ist er nicht erreichbar, uebernimmt STT_BASE
# (Parakeet) automatisch. NIE ElevenLabs. Leer = Verhalten wie vorher.
#   vom pickadoc1-App-Container (Tailscale): STT_WHISPER_BASE=ws://100.81.214.94:8092
STT_WHISPER_BASE=
STT_WHISPER_KEY=pickadoc-stt-dev-key

# Stimmname im TTS-Container (Referenz in tts_serve/stimmen/): Lisa-Prozess
# nimmt "lisa", der Bianca-Prozess setzt sich selbst auf "bianca".
TTS_VOICE=

# Kalender / Patientensuche: Pickadoc Cloud Functions, ohne MAS.
PICKADOC_CF_BASE=https://europe-west3-docgenda.cloudfunctions.net

# Optional: MAS nur fuer Terminhistorie (lesen). Leer = Lisa bleibt autark.
MAS_URL=
