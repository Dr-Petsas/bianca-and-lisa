# Secrets NIE ins Image
.env
*.env
!.env.example

.venv/
.git/
.data/
.run/
.cursor/
__pycache__/
**/__pycache__/
# Test-Studio faehrt mit ins Image (30.08.2026): nur Baukasten-Code + Web,
# Render-Caches (audio/berichte) kommen als Volumes dazu.
tests/*
!tests/baukasten
tests/baukasten/audio/
tests/baukasten/berichte/
tests/baukasten/__pycache__/
tts_serve/
# stt_serve bleibt draussen bis auf die Nachkorrektur (Whisper-Pfad im App-
# Image); das Parakeet-Modell (stt_serve/modell/) gehoert NIE in den Kontext.
stt_serve/*
!stt_serve/postcorrect.py
tools/*
!tools/prod_smoke.py
# DIALOG_CONTROLLER: der Shadow-Reporter ist ein reines Ops-Werkzeug
# (read-only), muss aber im Image liegen, damit `docker exec … python
# tools/shadow_bericht.py` ohne docker cp laeuft.
!tools/shadow_bericht.py
# Live-Proben laufen laut AGENTS.md IM Container ("docker exec … python
# tools/_probe_…") — ohne diese Ausnahme muesste jede Session sie erst per
# docker cp hineinschieben (13.09.2026 genau so passiert).
!tools/_probe_*.py
*.ps1
*.md
