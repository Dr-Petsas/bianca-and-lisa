# Secrets NIE ins Image
.env
*.env
!.env.example

.venv/
.git/
.data/
.run/
.cursor/
__pycache__/
**/__pycache__/
# Test-Studio faehrt mit ins Image (30.08.2026): nur Baukasten-Code + Web,
# Render-Caches (audio/berichte) kommen als Volumes dazu.
tests/*
!tests/baukasten
tests/baukasten/audio/
tests/baukasten/berichte/
tests/baukasten/__pycache__/
tts_serve/
# stt_serve bleibt draussen bis auf die Nachkorrektur (Whisper-Pfad im App-
